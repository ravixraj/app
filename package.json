		"bits-ui": "^2.18.0",
		"cn": "^0.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
